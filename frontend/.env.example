# =============================================================================
# CIVICPULSE CONFIGURATION & ENVIRONMENT BLUEPRINT
# =============================================================================
# Copy this file to .env or .env.local for local development.
# NEVER commit real credentials or production secrets to Git.

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SERVER ONLY)
# -----------------------------------------------------------------------------
# For Local/Demo Offline Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Production Deployment (PostgreSQL):
# DATABASE_URL="postgresql://civic_user:password@localhost:5432/civicpulse?schema=public&sslmode=prefer"

# -----------------------------------------------------------------------------
# 2. APPLICATION URLS (PUBLIC)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSIONS (SERVER ONLY - FUTURE STAGE)
# -----------------------------------------------------------------------------
# AUTH_SECRET="generate-a-secure-32-byte-secret-here"
# AUTH_SESSION_MAX_AGE="86400" # 24 hours in seconds

# -----------------------------------------------------------------------------
# 4. MEDIA UPLOAD & OBJECT STORAGE (SERVER ONLY - FUTURE STAGE)
# -----------------------------------------------------------------------------
# Options: "local" | "s3" | "cloudinary"
MEDIA_STORAGE_PROVIDER="local"
MEDIA_STORAGE_LOCAL_DIR="./public/uploads"
MEDIA_STORAGE_PUBLIC_BASE_URL="/uploads"

# Cloudinary Credentials (if MEDIA_STORAGE_PROVIDER="cloudinary")
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# AWS S3 / Cloudflare R2 Credentials (if MEDIA_STORAGE_PROVIDER="s3")
# S3_BUCKET_NAME=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# -----------------------------------------------------------------------------
# 5. AI INTELLIGENCE ENGINE (SERVER ONLY - FUTURE STAGE)
# -----------------------------------------------------------------------------
# Options: "heuristic" (current rule-based) | "openai" | "google_gemini"
AI_PROVIDER="heuristic"
# AI_API_KEY=""
# AI_EMBEDDING_MODEL="text-embedding-3-small"
