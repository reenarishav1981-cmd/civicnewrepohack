# =========================================================================
# CivicPulse Environment Configuration
# =========================================================================

# Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Core Backend Configuration (:8000)
PORT=8000
HOST=0.0.0.0
MONGO_URI=mongodb://localhost:27017/civicpulse
AI_ENGINE_URL=http://localhost:8001
JWT_SECRET=change-this-secret-key-for-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# AI Engine Configuration (:8001)
AI_ENGINE_PORT=8001
AI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
